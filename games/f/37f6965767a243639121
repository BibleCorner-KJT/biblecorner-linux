 if(location.hash==='#contact')open();
 dlg.addEventListener('click',function(e){if(e.target===dlg)close()});
 form.addEventListener('submit',function(e){e.preventDefault();
  var msg=form.message.value.trim();if(msg.length<5){status.textContent='Please write your message.';status.className='kjt-contact__status is-bad';form.message.focus();return}
  send.disabled=true;status.textContent='Sending…';status.className='kjt-contact__status';
  var body=new URLSearchParams({action:'kjt_contact',name:form.name.value,email:form.email.value,message:msg,website:form.website.value,elapsed:String(Date.now()-opened),page:location.href.split('#')[0]});
  fetch("https:\/\/knowingjesus.today\/wp-admin\/admin-ajax.php",{method:'POST',credentials:'same-origin',body:body}).then(function(r){return r.json()}).then(function(j){
   if(j&&j.success){status.textContent=j.data.message;status.className='kjt-contact__status is-ok';form.reset();setTimeout(close,2500)}
   else{status.textContent=(j&&j.data&&j.data.message)||'Your message could not be sent. Please try again.';status.className='kjt-contact__status is-bad'}
  }).catch(function(){status.textContent='Your message could not be sent. Please check your connection and try again.';status.className='kjt-contact__status is-bad'}).then(function(){send.disabled=false});
 });
})();
</script>
