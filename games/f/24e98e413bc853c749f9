  send.disabled=true;status.textContent='Sending…';status.className='kjt-contact__status';
  var body=new URLSearchParams({action:'kjt_contact',name:form.name.value,email:form.email.value,message:msg,website:form.website.value,elapsed:String(Date.now()-opened),page:location.href.split('#')[0]});
  fetch("https:\/\/biblecorner.com\/wp-admin\/admin-ajax.php",{method:'POST',credentials:'same-origin',body:body}).then(function(r){return r.json()}).then(function(j){
