<script id="kjt-watermark-js-after">
window.KJT_WM="biblecorner.com";(function(){'use strict';
var TXT=window.KJT_WM||'',SKIP='header,footer,.bfp-header,.bfp-footer,.kjt-brand-logo,.kjt-langmenu,.kg-app,.kgm,.kc-overlay,.kc-choose,.kgm-bgs,.kjtb,.kjtb-reader,[data-kjt-nowm],.kpe-cover',done=new WeakSet();
