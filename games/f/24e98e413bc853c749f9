<style>
.kjt-contact-links{display:flex;flex-wrap:wrap;justify-content:center;gap:.75rem;margin:1rem 0 .75rem}
/* 7.18.2: one small "Talk to us" pill with three round buttons (mail, Telegram, SimpleX) */
.kjt-talk{display:inline-flex;align-items:center;gap:.4rem;padding:.3rem .35rem .3rem 1rem;border-radius:999px;background:#fff;box-shadow:0 6px 18px rgba(0,0,0,.28)}
.kjt-talk__label{font:800 .98rem/1.2 system-ui,-apple-system,"Segoe UI",sans-serif;color:#3E093F;margin-inline-end:.25rem;white-space:nowrap}
.kjt-talk__btn{display:inline-flex;align-items:center;justify-content:center;width:2.4rem;height:2.4rem;padding:0;border:0;border-radius:50%;background:transparent;cursor:pointer;text-decoration:none!important;transition:transform .15s}
.kjt-talk__btn:hover,.kjt-talk__btn:focus-visible{transform:translateY(-2px);outline:3px solid #ffd166;outline-offset:1px}
.kjt-talk__btn .kjt-contact-mail{width:30px;height:30px;font-size:1rem}
.kjt-talk__btn svg{display:block}
.kjt-contact-link{display:inline-flex;align-items:center;gap:.55rem;padding:.7rem 1.35rem;border-radius:999px;border:0;font:800 1rem/1.2 system-ui,-apple-system,"Segoe UI",sans-serif;text-decoration:none!important;cursor:pointer;box-shadow:0 6px 18px rgba(0,0,0,.28);transition:transform .15s,box-shadow .15s}
.kjt-contact-link:hover,.kjt-contact-link:focus-visible{transform:translateY(-2px);box-shadow:0 10px 24px rgba(0,0,0,.35);outline:3px solid #ffd166;outline-offset:2px}
.kjt-contact-link--tg{background:#fff;color:#1b6fa8!important}
.kjt-contact-link--mail{background:#ffd166;color:#3E093F!important}
.kjt-contact-link--sx{background:#fff;color:#023789!important}
.kjt-contact-tg{flex:0 0 auto;display:block}
.kjt-contact-mail{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:#3E093F;color:#ffd166;font-size:.8rem}
.kjt-contact-links--float{position:relative;padding:1rem;background:#3E093F;color:#fff}
.kjt-contact{width:min(34rem,calc(100vw - 2rem));border:0;border-radius:1.25rem;padding:0;box-shadow:0 24px 60px rgba(0,0,0,.35);color:#172033}
.kjt-contact::backdrop{background:rgba(23,10,30,.55)}
.kjt-contact__form{display:grid;gap:.75rem;padding:1.25rem 1.25rem 1.1rem;font:400 1rem/1.45 system-ui,-apple-system,"Segoe UI",sans-serif}
.kjt-contact__head{display:flex;align-items:center;justify-content:space-between;gap:1rem}
.kjt-contact__head h2{margin:0;color:#3E093F;font:700 1.4rem/1.2 Georgia,"Times New Roman",serif}
.kjt-contact__x{width:2.2rem;height:2.2rem;border:0;border-radius:999px;background:#f1eaf2;color:#3E093F;font-weight:800;cursor:pointer}
.kjt-contact__intro{margin:0;font-size:.92rem;color:#4b5263}.kjt-contact__intro a{color:#3E093F;font-weight:700}
.kjt-contact label{display:grid;gap:.3rem;font-weight:700;font-size:.9rem;color:#3E093F}
.kjt-contact label span{font-weight:400;color:#6b7280;font-size:.8rem}
.kjt-contact input,.kjt-contact textarea{width:100%;box-sizing:border-box;padding:.6rem .7rem;border:1px solid #d6cbd9;border-radius:.6rem;font:inherit;font-weight:400;color:#172033;background:#fff}
.kjt-contact input:focus,.kjt-contact textarea:focus{outline:2px solid #c9a227;border-color:#c9a227}
.kjt-contact__trap{position:absolute!important;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.kjt-contact__status{margin:0;min-height:1.2em;font-size:.9rem}
.kjt-contact__status.is-ok{color:#2f6b3a;font-weight:700}.kjt-contact__status.is-bad{color:#b42318;font-weight:700}
.kjt-contact__acts{display:flex;justify-content:flex-end}
