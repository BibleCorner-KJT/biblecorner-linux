/* KJT's one canonical back-to-top button. */
#kjt-canonical-top{
 position:fixed!important;
 right:18px!important;
 bottom:92px!important;
 z-index:99980!important;
 width:46px!important;
 height:46px!important;
 border:0!important;
 border-radius:999px!important;
 background:#3e093f!important;
 color:#fff!important;
 box-shadow:0 5px 18px rgba(0,0,0,.22)!important;
 display:none;
 align-items:center!important;
 justify-content:center!important;
 cursor:pointer!important;
 font-size:24px!important;
 line-height:1!important;
 padding:0!important;
}
#kjt-canonical-top.kjt-show{display:flex!important}

/* Floating yellow/category controls are useful navigation, not another
   back-to-top. Give them their own lane above the canonical arrow. */
[data-kjt-category-float],
.kjt-category-float,
.kjt-floating-category{
 right:18px!important;
 bottom:150px!important;
 z-index:99970!important;
}

/* Mobile: CAPTCHA is especially easy to cover, so lift both controls. */
@media(max-width:640px){
 #kjt-canonical-top{right:12px!important;bottom:104px!important;width:42px!important;height:42px!important}
 [data-kjt-category-float],.kjt-category-float,.kjt-floating-category{right:12px!important;bottom:158px!important}
}
