<style id="kjtb-lect-css">.kjtb-lect{max-width:760px;margin:14px 0 18px;padding:14px 16px 16px;background:#fffdf6;color:#172033;border:1px solid #e3d3a0;border-top:5px solid #c9a227;border-radius:16px;box-shadow:0 6px 18px rgba(23,32,51,.08);font:400 1rem/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}
