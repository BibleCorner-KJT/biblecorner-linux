<!--kjt-baked--><main><section class="kjt-kids-hero bg-purple-deep relative overflow-hidden text-white"><div class="relative mx-auto grid max-w-7xl gap-8 px-5 py-10 sm:px-8 sm:py-14 lg:grid-cols-[minmax(0,1fr)_minmax(22rem,0.82fr)] lg:items-start lg:gap-12 lg:py-18"><div class="max-w-3xl"><p class="text-yellow mb-4 text-xs font-bold tracking-[0.24em] uppercase">Kids Corner · Learn and imagine</p><h1 class="font-display text-4xl leading-[0.98] sm:text-6xl">Kids Corner</h1><div class="mt-5 max-w-2xl text-lg leading-8 text-white/85">Bible stories, games and colouring for children, in a safe place.</div><div class="kv-card" data-kjt-kids-votd data-daily="19"><script type="application/json" class="kv-pool">[{"id":0,"text":"In the beginning God created the heaven and the earth.","reference":"Genesis 1:1","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Genesis/1/1"},{"id":1,"text":"The LORD is my shepherd; I shall not want.","reference":"Psalm 23:1","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Psalms/23/1"},{"id":2,"text":"What time I am afraid, I will trust in thee.","reference":"Psalm 56:3","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Psalms/56/3"},{"id":3,"text":"Thy word is a lamp unto my feet, and a light unto my path.","reference":"Psalm 119:105","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Psalms/119/105"},{"id":4,"text":"Be still, and know that I am God.","reference":"Psalm 46:10","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Psalms/46/10"},{"id":5,"text":"This is the day which the LORD hath made; we will rejoice and be glad in it.","reference":"Psalm 118:24","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Psalms/118/24"},{"id":6,"text":"I will say of the LORD, He is my refuge and my fortress: my God; in him will I trust.","reference":"Psalm 91:2","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Psalms/91/2"},{"id":7,"text":"Trust in the LORD with all thine heart; and lean not unto thine own understanding.","reference":"Proverbs 3:5","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Proverbs/3/5"},{"id":8,"text":"A friend loveth at all times.","reference":"Proverbs 17:17","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Proverbs/17/17"},{"id":9,"text":"Be strong and of a good courage; be not afraid.","reference":"Joshua 1:9","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Joshua/1/9"},{"id":10,"text":"Fear thou not; for I am with thee.","reference":"Isaiah 41:10","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Isaiah/41/10"},{"id":11,"text":"For unto you is born this day in the city of David a Saviour, which is Christ the Lord.","reference":"Luke 2:11","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Luke/2/11"},{"id":12,"text":"Glory to God in the highest, and on earth peace, good will toward men.","reference":"Luke 2:14","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Luke/2/14"},{"id":13,"text":"I am the bread of life.","reference":"John 6:35","link":"https://knowingjesus.today/bible-corner/#/p/kjva/John/6/35"},{"id":14,"text":"I am the light of the world.","reference":"John 8:12","link":"https://knowingjesus.today/bible-corner/#/p/kjva/John/8/12"},{"id":15,"text":"I am the good shepherd.","reference":"John 10:11","link":"https://knowingjesus.today/bible-corner/#/p/kjva/John/10/11"},{"id":16,"text":"I am the way, the truth, and the life.","reference":"John 14:6","link":"https://knowingjesus.today/bible-corner/#/p/kjva/John/14/6"},{"id":17,"text":"For God so loved the world, that he gave his only begotten Son.","reference":"John 3:16","link":"https://knowingjesus.today/bible-corner/#/p/kjva/John/3/16"},{"id":18,"text":"Love one another; as I have loved you.","reference":"John 13:34","link":"https://knowingjesus.today/bible-corner/#/p/kjva/John/13/34"},{"id":19,"text":"Peace, be still.","reference":"Mark 4:39","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Mark/4/39"},{"id":20,"text":"Suffer the little children to come unto me.","reference":"Mark 10:14","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Mark/10/14"},{"id":21,"text":"Let your light so shine before men, that they may see your good works.","reference":"Matthew 5:16","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Matthew/5/16"},{"id":22,"text":"Blessed are the peacemakers: for they shall be called the children of God.","reference":"Matthew 5:9","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Matthew/5/9"},{"id":23,"text":"Ask, and it shall be given you; seek, and ye shall find.","reference":"Matthew 7:7","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Matthew/7/7"},{"id":24,"text":"And, lo, I am with you alway, even unto the end of the world.","reference":"Matthew 28:20","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Matthew/28/20"},{"id":25,"text":"It is more blessed to give than to receive.","reference":"Acts 20:35","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Acts/20/35"},{"id":26,"text":"I can do all things through Christ which strengtheneth me.","reference":"Philippians 4:13","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Philippians/4/13"},{"id":27,"text":"Rejoice in the Lord alway: and again I say, Rejoice.","reference":"Philippians 4:4","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Philippians/4/4"},{"id":28,"text":"And be ye kind one to another, tenderhearted, forgiving one another.","reference":"Ephesians 4:32","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Ephesians/4/32"},{"id":29,"text":"Pray without ceasing.","reference":"1 Thessalonians 5:17","link":"https://knowingjesus.today/bible-corner/#/p/kjva/1%20Thessalonians/5/17"},{"id":30,"text":"God is love.","reference":"1 John 4:8","link":"https://knowingjesus.today/bible-corner/#/p/kjva/1%20John/4/8"},{"id":31,"text":"We love him, because he first loved us.","reference":"1 John 4:19","link":"https://knowingjesus.today/bible-corner/#/p/kjva/1%20John/4/19"},{"id":32,"text":"Children, obey your parents in the Lord: for this is right.","reference":"Ephesians 6:1","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Ephesians/6/1"},{"id":33,"text":"And whatsoever ye do, do it heartily, as to the Lord.","reference":"Colossians 3:23","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Colossians/3/23"},{"id":34,"text":"Give, and it shall be given unto you.","reference":"Luke 6:38","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Luke/6/38"},{"id":35,"text":"He is not here: for he is risen, as he said.","reference":"Matthew 28:6","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Matthew/28/6"},{"id":36,"text":"Be ye therefore merciful, as your Father also is merciful.","reference":"Luke 6:36","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Luke/6/36"},{"id":37,"text":"Honour thy father and thy mother.","reference":"Exodus 20:12","link":"https://knowingjesus.today/bible-corner/#/p/kjva/Exodus/20/12"}]</script><span class="kv-sparkle kv-sparkle--1" aria-hidden="true">✦</span><span class="kv-sparkle kv-sparkle--2" aria-hidden="true">✦</span><p class="kv-label"><span aria-hidden="true">☀️</span> Today’s verse</p><blockquote class="kv-text">“Peace, be still.”</blockquote><div class="kv-foot"><a class="kv-ref" href="https://knowingjesus.today/bible-corner/#/p/kjva/Mark/4/39" title="Read it in the Bible">Mark 4:39 <span aria-hidden="true">&#8599;</span></a><span class="kv-btns"><button type="button" class="kv-btn kv-btn--copy" data-kv-copy><span aria-hidden="true">📋</span> Copy verse</button><button type="button" class="kv-btn kv-btn--more" data-kv-more><span aria-hidden="true">🎲</span> Another verse</button></span></div><p class="kv-done" aria-live="polite"></p></div></div><div class="kjt-kids-hero__col lg:w-full lg:max-w-[30rem] lg:justify-self-end"><div class="kjt-kids-hero__frame relative min-h-[20rem] overflow-hidden rounded-[1.75rem] border border-white/20 bg-black/20 shadow-2xl sm: