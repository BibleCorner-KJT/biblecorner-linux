 var spot=document.querySelector('footer .kjt-footer-legal')||document.querySelector('footer');
 if(spot)spot.insertBefore(links,spot.firstChild);else links.classList.add('kjt-contact-links--float');
 links.hidden=false;
 var form=dlg.querySelector('form'),status=dlg.querySelector('.kjt-contact__status'),send=dlg.querySelector('.kjt-contact__send'),opened=0;
 function open(){opened=Date.now();status.textContent='';status.className='kjt-contact__status';if(dlg.showModal)dlg.showModal();else dlg.setAttribute('open','');setTimeout(function(){var t=form.querySelector('textarea');if(t)t.focus()},50)}
