<script id="kjt-332-floating-js-after">
document.addEventListener('DOMContentLoaded',()=>{
 /* Identify duplicate fixed/floating controls that are genuinely "top"
    actions. Do not remove category/navigation buttons merely because they
    happen to float. */
 const topish=(el)=>{
   const text=((el.getAttribute('data-kjt-en-label')||el.getAttribute('aria-label'))||el.getAttribute('title')||el.textContent||'').trim().toLowerCase();
   const href=(el.getAttribute('href')||'').trim().toLowerCase();
   const idc=((el.id||'')+' '+(el.className||'')).toLowerCase();
   return /back\s*to\s*top|scroll\s*to\s*top|to\s*top/.test(text) ||
          href==='#top' || href==='#page-top' ||
          /back[-_ ]?to[-_ ]?top|scroll[-_ ]?top/.test(idc);
 };
 document.querySelectorAll('a,button').forEach(el=>{
   if(topish(el) && el.id!=='kjt-canonical-top'){
     el.setAttribute('data-kjt-duplicate-top','1');
     el.style.setProperty('display','none','important');
   }
 });

 let b=document.getElementById('kjt-canonical-top');
 if(!b){
   b=document.createElement('button');
   b.id='kjt-canonical-top'; b.type='button';
   b.setAttribute('aria-label','Back to top');
   b.setAttribute('title','Back to top');
   b.innerHTML='↑';
   document.body.appendChild(b);
 }
 b.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));
 const sync=()=>b.classList.toggle('kjt-show',window.scrollY>500);
 addEventListener('scroll',sync,{passive:true}); sync();

 /* Detect a yellow floating control without assuming its theme class.
    If it is NOT a top action, mark it as category navigation so CSS places
    it in a separate lane. */
 [...document.querySelectorAll('a,button')].forEach(el=>{
   if(el.id==='kjt-canonical-top'||topish(el))return;
   const cs=getComputedStyle(el);
   if(cs.position!=='fixed')return;
   const r=el.getBoundingClientRect();
   if(r.right < innerWidth-220 || r.bottom < innerHeight-240)return;
   const bg=cs.backgroundColor||'';
   /* Broad yellow/gold detection from computed RGB. */
   const m=bg.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
   if(m){
     const R=+m[1],G=+m[2],B=+m[3];
     if(R>180 && G>130 && B<130)el.setAttribute('data-kjt-category-float','1');
   }
 });
});
